#!/usr/bin/env bash
# Everything a new wallpaper sets besides the picture on screen:
#
#     wallpaper-apply FILE
#
#   ~/.cache/current_wallpaper_source -> FILE
#   ~/.cache/current_wallpaper        -> FILE
#
# Noctalia owns wallpaper display and palette application. These compatibility
# links remain for lock screens, theme panels and existing user scripts.
#
# services/WallpaperEngine.qml runs it; scripts/setwall too without the shell.

file=$1
[[ -f $file ]] || { echo "wallpaper-apply: '$file' not found" >&2; exit 1; }
mkdir -p "$HOME/.cache"
ln -sfn "$file" "$HOME/.cache/current_wallpaper_source"
ln -sfn "$file" "$HOME/.cache/current_wallpaper"
