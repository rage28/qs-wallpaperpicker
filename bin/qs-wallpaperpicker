#!/usr/bin/env bash
# qs-wallpaperpicker: the Quickshell wallpaper picker.
# Runs either a Nix-packaged config or a source/install.sh checkout.
#
#   qs-wallpaperpicker              start it (put this in your autostart)
#   qs-wallpaperpicker toggle       open/close the picker
#   qs-wallpaperpicker wallhaven    open the picker on Wallhaven
#   qs-wallpaperpicker set FILE     set a wallpaper (a name in the wallpaper
#                                   folder, or a path)
#   qs-wallpaperpicker current      the wallpaper's path
#   qs-wallpaperpicker stop         quit it
#   qs-wallpaperpicker log          its log
set -euo pipefail

user_cfg="${XDG_CONFIG_HOME:-$HOME/.config}/qs-wallpaperpicker"
cfg="${QS_WALLPAPERPICKER_CONFIG:-$user_cfg}"

# QML and Noctalia write mutable state here even when the application itself
# lives in the read-only Nix store. Keep the shipped template available at a
# stable user path for Noctalia's config.
mkdir -p "$user_cfg/colors" "$user_cfg/noctalia"
if [[ -f $cfg/extras/noctalia/quickshell.json ]]; then
    install -m 0644 "$cfg/extras/noctalia/quickshell.json" "$user_cfg/noctalia/quickshell.json"
    install -m 0644 "$cfg/extras/noctalia/qs-wallpaperpicker.toml" "$user_cfg/noctalia/qs-wallpaperpicker.toml"
fi

case ${1-} in -h | --help | help) ;; *)
    [[ -f $cfg/shell.qml ]] || { echo "qs-wallpaperpicker: no Quickshell config found in $cfg" >&2; exit 1; } ;;
esac

usage() { sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; }

case ${1-start} in
    start)     exec qs -p "$cfg" --no-duplicate ;;
    toggle)
        # A keybind should work even when the picker was not separately
        # autostarted. The first call also handles the normal running case.
        if qs -p "$cfg" ipc call wallpaper toggle >/dev/null 2>&1; then
            exit 0
        fi
        setsid -f qs -p "$cfg" --no-duplicate >/dev/null 2>&1
        for _ in {1..50}; do
            sleep 0.1
            if qs -p "$cfg" ipc call wallpaper toggle >/dev/null 2>&1; then
                exit 0
            fi
        done
        echo "qs-wallpaperpicker: picker did not become ready; inspect: qs-wallpaperpicker log" >&2
        exit 1
        ;;
    wallhaven) exec qs -p "$cfg" ipc call wallpaper wallhaven ;;
    set)
        [[ -n ${2-} ]] || { usage >&2; exit 1; }
        # A relative path from here, not a name in the wallpaper folder.
        file=$2
        [[ $file != /* && -e $file ]] && file=$(realpath "$file")
        exec qs -p "$cfg" ipc call wallpaper set "$file" ;;
    current)   exec qs -p "$cfg" ipc call wallpaper current ;;
    stop)      exec qs -p "$cfg" kill ;;
    log)       exec qs -p "$cfg" log ;;
    -h|--help|help) usage ;;
    *) usage >&2; exit 1 ;;
esac
